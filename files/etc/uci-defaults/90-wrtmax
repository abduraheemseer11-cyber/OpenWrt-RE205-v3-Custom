#!/bin/sh
# WrtMax first-boot defaults.
# OpenWrt runs /etc/uci-defaults/* on first boot and again after every factory
# reset, so these values come back whenever the device is reset.

# LAN address 192.168.1.20 avoids clashing with the main router at 192.168.1.1.
uci -q batch <<EOF
set network.lan.ipaddr='192.168.1.20'
set network.lan.netmask='255.255.255.0'
set system.@system[0].hostname='WrtMax'
commit network
commit system
EOF

# Create the default wireless config if it is missing.
# radio0 is the 2.4 GHz radio (phy0) and radio1 is the 5 GHz radio (phy1),
# matching the LED triggers in the upstream RE205 v3 device tree.
uci -q get wireless.radio0 > /dev/null || wifi config > /dev/null 2>&1

uci -q batch <<EOF
set wireless.radio0.disabled='0'
set wireless.radio1.disabled='0'
set wireless.default_radio0.ssid='AbduRaheem_2G'
set wireless.default_radio1.ssid='AbduRaheem_5G'
set wireless.default_radio0.network='lan'
set wireless.default_radio1.network='lan'
commit wireless
EOF

# Default panel PIN: the last six hex digits of the Ethernet MAC, uppercase.
# Only the SHA-256 hash is stored, and only if no PIN exists yet.
PIN_FILE=/etc/wrtmax/pin.sha256
if [ ! -s "$PIN_FILE" ]; then
	MAC=$(tr -d ':' < /sys/class/net/eth0/address 2>/dev/null)
	DEFPIN=$(printf '%s' "$MAC" | tail -c 6 | tr 'a-f' 'A-F')
	if [ -n "$DEFPIN" ]; then
		printf '%s' "$DEFPIN" | sha256sum | cut -d' ' -f1 > "$PIN_FILE"
	fi
fi

exit 0
