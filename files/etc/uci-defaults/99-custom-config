#!/bin/sh
# Alameer Software AP profile for TP-Link RE205 v3.
# This script is run once by /etc/uci-defaults on first boot.
set -eu

# Remove routed WAN interfaces (including legacy WAN6 section).
uci -q delete network.wan || true
uci -q delete network.wan6 || true

# Keep the device reachable at a predictable management address.
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.20'
uci set network.lan.netmask='255.255.255.0'

# Make LAN DHCP server silent; upstream router should provide DHCP.
if uci -q get dhcp.lan >/dev/null; then
    uci set dhcp.lan.ignore='1'
else
    uci set dhcp.lan='dhcp'
    uci set dhcp.lan.interface='lan'
    uci set dhcp.lan.ignore='1'
fi

# Ensure both radios are enabled and configure two open APs bridged to LAN.
for radio in radio0 radio1; do
    if uci -q get "wireless.${radio}" >/dev/null; then
        uci set "wireless.${radio}.disabled=0"
    fi
done

# Create or update stable named wifi-iface sections.
uci -q delete wireless.alameer_2g || true
uci set wireless.alameer_2g='wifi-iface'
uci set wireless.alameer_2g.device='radio0'
uci set wireless.alameer_2g.mode='ap'
uci set wireless.alameer_2g.network='lan'
uci set wireless.alameer_2g.ssid='AbduRaheem_2G'
uci set wireless.alameer_2g.encryption='none'

uci -q delete wireless.alameer_5g || true
uci set wireless.alameer_5g='wifi-iface'
uci set wireless.alameer_5g.device='radio1'
uci set wireless.alameer_5g.mode='ap'
uci set wireless.alameer_5g.network='lan'
uci set wireless.alameer_5g.ssid='AbduRaheem_5G'
uci set wireless.alameer_5g.encryption='none'

# Radio-specific channel and requested power settings.
uci set wireless.radio0.channel='6'
uci set wireless.radio0.txpower='30'
uci set wireless.radio1.channel='36'
uci set wireless.radio1.htmode='HT40'
uci set wireless.radio1.txpower='30'

uci commit network
uci commit dhcp
uci commit wireless

# First-boot execution may happen before all services are fully started.
# Reloads are best-effort; normal init will bring them up if not ready yet.
(/etc/init.d/network reload >/dev/null 2>&1 || true)
(wifi reload >/dev/null 2>&1 || true)

exit 0
