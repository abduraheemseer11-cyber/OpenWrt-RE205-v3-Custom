#!/bin/sh /etc/rc.common
# WrtMax services: rogue-DHCP protection and the stability watchdog.
START=99
USE_PROCD=1

start_service() {
	/usr/sbin/wrtmax-guard apply >/dev/null 2>&1
	procd_open_instance
	procd_set_param command /usr/sbin/wrtmax-watchdog
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	/usr/sbin/wrtmax-guard apply >/dev/null 2>&1
}

stop_service() {
	/usr/sbin/wrtmax-guard flush >/dev/null 2>&1
}
