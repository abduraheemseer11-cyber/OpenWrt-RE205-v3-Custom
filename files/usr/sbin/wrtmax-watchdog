#!/bin/sh
# WrtMax stability monitor (started by /etc/init.d/wrtmax).
#   - every 30 s, ping the host in wrtmax.main.watchdog_host
#   - after 3 failed checks, restart the Wi-Fi radios
#   - after 10 failed checks, reboot the device
#   - reboot once a day at wrtmax.main.reboot_time (HH:MM) when it is set
# Checks run only when wrtmax.main.watchdog is 1. Do not enable it when the
# watched host can go down on its own (for example the main router),
# because the reboot step would then run repeatedly.

INTERVAL=30
WIFI_FAILS=3
REBOOT_FAILS=10

fails=0
last_reboot_day=""

get() {
	uci -q get "wrtmax.main.$1"
}

while :; do
	if [ "$(get watchdog)" != "1" ]; then
		sleep 60
		continue
	fi

	host="$(get watchdog_host)"
	[ -n "$host" ] || host=192.168.1.1

	at="$(get reboot_time)"
	today="$(date +%Y-%m-%d)"
	if [ -n "$at" ] && [ "$(date +%H:%M)" = "$at" ] && [ "$last_reboot_day" != "$today" ]; then
		last_reboot_day="$today"
		logger -t wrtmax "scheduled reboot at $at"
		reboot
	fi

	if ping -c 2 -W 3 "$host" >/dev/null 2>&1; then
		fails=0
	else
		fails=$((fails + 1))
		logger -t wrtmax "watchdog: $host unreachable ($fails)"
		if [ "$fails" -ge "$REBOOT_FAILS" ]; then
			logger -t wrtmax "watchdog: rebooting after $fails failed checks"
			reboot
		elif [ "$fails" -ge "$WIFI_FAILS" ] && [ $((fails % WIFI_FAILS)) -eq 0 ]; then
			logger -t wrtmax "watchdog: restarting Wi-Fi"
			wifi reload
		fi
	fi

	sleep "$INTERVAL"
done
