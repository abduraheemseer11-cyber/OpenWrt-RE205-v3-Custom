#!/bin/sh
# Scan nearby networks on every radio and print one TSV line per band and channel:
#   band <TAB> channel <TAB> networks <TAB> congestion_pct
# congestion_pct is relative: 100 is the busiest channel seen on that band, 0 the quietest.
# It is computed from beacon power, not from the radio's busy-time counters.
# Scanning can take several seconds and may briefly disturb the access point.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

{
	for IF in $(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2 }'); do
		iw dev "$IF" scan 2>/dev/null
	done
} | awk '
function add(    band, ch, key) {
	if (freq == "") return
	band = (freq < 3000) ? "2.4" : "5"
	ch = (band == "2.4") ? int((freq - 2407) / 5) : int((freq - 5000) / 5)
	key = band SUBSEP ch
	weight[key] += 10 ^ (sig / 10)
	count[key] += 1
}
/^BSS / { add(); freq = ""; sig = -100 }
/^[[:space:]]*freq:/ { freq = $2 + 0 }
/^[[:space:]]*signal:/ { sig = $2 + 0 }
END {
	add()
	for (key in weight) {
		split(key, p, SUBSEP)
		if (weight[key] > peak[p[1]]) peak[p[1]] = weight[key]
	}
	for (key in weight) {
		split(key, p, SUBSEP)
		pct = (peak[p[1]] > 0) ? int(weight[key] * 100 / peak[p[1]]) : 0
		printf "%s\t%s\t%d\t%d\n", p[1], p[2], count[key], pct
	}
}'
