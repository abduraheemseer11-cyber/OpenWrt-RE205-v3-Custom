#!/bin/sh
# GET /cgi-bin/wrtmax-clients - Wi-Fi clients with name, IP, signal and rate (read-only)
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

LEASES=/tmp/dhcp.leases
[ -r "$LEASES" ] || LEASES=/dev/null

printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'

OBJS=$(
	for IF in $(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2 }'); do
		iw dev "$IF" station dump 2>/dev/null | awk -v ifn="$IF" -v leases="$LEASES" '
		function emit(    name) {
			name = host[mac]
			gsub(/[^A-Za-z0-9._-]/, "", name)
			printf "{\"mac\":\"%s\",\"iface\":\"%s\",\"ip\":\"%s\",\"name\":\"%s\",\"signal\":%s,\"rate_mbit\":%s}\n", mac, ifn, ip[mac], name, sig, rate
		}
		BEGIN {
			while ((getline line < leases) > 0) {
				split(line, f, " ")
				ip[tolower(f[2])] = f[3]
				host[tolower(f[2])] = f[4]
			}
			close(leases)
		}
		/^Station/ {
			if (mac != "") emit()
			mac = tolower($2); sig = "null"; rate = "null"
		}
		$1 == "signal:" { sig = $2 }
		$1 == "tx" && $2 == "bitrate:" { rate = $3 }
		END { if (mac != "") emit() }
		'
	done
)

printf '{"clients":[%s]}\n' "$(printf '%s\n' "$OBJS" | paste -sd, -)"
