#!/bin/sh
# GET /cgi-bin/wrtmax-analyzer - nearby networks and congestion per channel (read-only, slow: scans)
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
printf '{"scanned_at":%s,"channels":[' "$(date +%s)"
/usr/sbin/wrtmax-scan | awk -F '\t' '
{
	printf "%s{\"band\":\"%s\",\"channel\":%s,\"networks\":%s,\"congestion_pct\":%s}", (NR > 1 ? "," : ""), $1, $2, $3, $4
}'
printf ']}\n'
